# Heat Chat - Environment Variables
# Copy this file to .env.local and fill in your values from:
# Supabase Dashboard → Project Settings → API

# Your Supabase project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase publishable key (Settings → API → Project API keys → publishable)
# Safe to expose in browser code. Never use the secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
